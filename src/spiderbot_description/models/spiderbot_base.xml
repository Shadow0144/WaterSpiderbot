<mujoco model="spiderbot">

    <compiler meshdir="meshes" texturedir="textures"/>

    <asset>
        <texture name="target_tex" type="2d" file="target.png"/>
        <texture name="target_gray_tex" type="2d" file="target_gray.png"/>
        <material name="target_mat" texture="target_tex"/>
        <material name="target_gray_mat" texture="target_gray_tex"/>
        <mesh name="arrow" file="arrow.obj" scale="1.0 1.0 1.0"/>
    </asset>

    <default>
        <default class="coxa">
            <joint type="hinge" axis="0 1 0" pos="0 0 0" limited="true" range="-45 45"/>
            <geom type="sphere" size="0.04" mass="1" contype="4" conaffinity="1"/>
        </default>
        <default class="femur">
            <joint type="hinge" axis="1 0 0" pos="0 0 0" limited="true" range="-90 0"/>
            <geom type="capsule" fromto="0 0 0  0 0 -0.25" size="0.04" mass="1"/>
        </default>
        <default class="tibia">
            <joint type="hinge" axis="1 0 0" pos="0 0 0" limited="true" range="-90 0"/>
            <geom type="capsule" fromto="0 0 0  0 0 -0.25" size="0.03" mass="1"/>
        </default>
        <default class="tarsus">
            <joint type="hinge" axis="1 0 0" pos="0 0 0" limited="true" range="-15 135"/>
            <geom type="capsule" fromto="0 0 0  0 0 -0.25" size="0.02" mass="1"/>
        </default>
        <default class="claw">
            <geom type="capsule" fromto="0 0 0  0 0 -0.025" size="0.02" rgba="0.5 0.5 0.5 1" friction="5.0 0.01 0.001"/>
        </default>
    </default>

    <worldbody>
        <body name="target" pos="0 0 0.75" mocap="true">
            <geom name="target_geom" type="mesh" mesh="arrow" material="target_mat" rgba="1.0 1.0 1.0 0.0" contype="0" conaffinity="0"/>
        </body>

        <body name="pose_arrow" pos="0 0 0.75" mocap="true">
            <geom name="pose_arrow_geom" type="mesh" mesh="arrow" material="target_gray_mat" rgba="1.0 1.0 1.0 0.0" contype="0" conaffinity="0"/>
        </body>

        <body name="cephalothorax" pos="0 0 0.35">
            <freejoint name="cephalothorax_joint"/>
            <geom type="ellipsoid" size="0.3 0.25 0.125" rgba="0 0 0 1" mass="0.5" friction="1 0.01 0.0001" contype="2" conaffinity="1"/>
            <site name="body_anchor_site" pos="0 0 0"/>
            
            <body name="tendon_anchor" pos="-0.05 0 0">
                <joint name="tendon_slide" type="slide" pos="0 0 0" axis="1 0 0" limited="true" range="-0.15 0.0" damping="2.0"/>
                <geom name="tendon_anchor_geom" type="box" size="0.02 0.01 0.01" mass="0.01" contype="0" conaffinity="0"/>
                <site name="tendon_tension_site" pos="0.02 0 0"/>
            </body>

            <body name="abdomen" pos="-0.5 0 0">
                <geom type="ellipsoid" size="0.35 0.275 0.125" rgba="0.2 0.2 0.2 1" mass="0.05" friction="1 0.01 0.0001"/>
            </body>
            
            <!-- Eyes -->
            <camera name="l_eye" pos="0.3 0.05 0" euler="90 -90 0"/>
            <camera name="r_eye" pos="0.3 -0.05 0" euler="90 -90 0"/>

            <!-- Cephalothorax connects to coxa [then trochanter] then femur [then patella] then tibia [then metatarsus] [then tarsus] then claws -->
            <!-- Legs are built dynamically with Python -->

        </body>
    </worldbody>

    <!-- Tendons -->
    <actuator>
        <position name="servo_tendon_tension" joint="tendon_slide" kp="50" ctrlrange="-0.15 0.0" forcerange="-100 100"/>
    </actuator>

    <!-- Left cephalothorax to coxa -->
    <actuator>
        <position name="servo_l_i_coxa_pitch" joint="l_i_cephalothorax_coxa_joint" kp="40" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_ii_coxa_pitch" joint="l_ii_cephalothorax_coxa_joint" kp="400" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iii_coxa_pitch" joint="l_iii_cephalothorax_coxa_joint" kp="40" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iv_coxa_pitch" joint="l_iv_cephalothorax_coxa_joint" kp="40" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>

    <!-- Left coxa to femur -->
    <actuator>
        <position name="servo_l_i_femur_pitch" joint="l_i_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_ii_femur_pitch" joint="l_ii_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iii_femur_pitch" joint="l_iii_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iv_femur_pitch" joint="l_iv_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>

    <!-- Left femur to tibia -->
    <actuator>
        <position name="servo_l_i_tibia_pitch" joint="l_i_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_ii_tibia_pitch" joint="l_ii_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iii_tibia_pitch" joint="l_iii_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iv_tibia_pitch" joint="l_iv_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>

    <!-- Left tibia to tarsus -->
    <actuator>
        <position name="servo_l_i_tarsus_pitch" joint="l_i_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_ii_tarsus_pitch" joint="l_ii_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iii_tarsus_pitch" joint="l_iii_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_l_iv_tarsus_pitch" joint="l_iv_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>

    <!-- Right cephalothorax to coxa -->
    <actuator>
        <position name="servo_r_i_coxa_pitch" joint="r_i_cephalothorax_coxa_joint" kp="40" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_ii_coxa_pitch" joint="r_ii_cephalothorax_coxa_joint" kp="40" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iii_coxa_pitch" joint="r_iii_cephalothorax_coxa_joint" kp="40" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iv_coxa_pitch" joint="r_iv_cephalothorax_coxa_joint" kp="40" ctrlrange="-45 45" forcerange="-100 100"/>
    </actuator>

    <!-- Right coxa to femur -->
    <actuator>
        <position name="servo_r_i_femur_pitch" joint="r_i_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_ii_femur_pitch" joint="r_ii_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iii_femur_pitch" joint="r_iii_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iv_femur_pitch" joint="r_iv_coxa_femur_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>

    <!-- Right femur to tibia -->
    <actuator>
        <position name="servo_r_i_tibia_pitch" joint="r_i_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_ii_tibia_pitch" joint="r_ii_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iii_tibia_pitch" joint="r_iii_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iv_tibia_pitch" joint="r_iv_femur_tibia_joint" kp="40" ctrlrange="-90 0" forcerange="-100 100"/>
    </actuator>

    <!-- Right tibia to tarsus -->
    <actuator>
        <position name="servo_r_i_tarsus_pitch" joint="r_i_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_ii_tarsus_pitch" joint="r_ii_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iii_tarsus_pitch" joint="r_iii_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>
    <actuator>
        <position name="servo_r_iv_tarsus_pitch" joint="r_iv_tibia_tarsus_joint" kp="40" ctrlrange="-15 135" forcerange="-100 100"/>
    </actuator>

</mujoco>