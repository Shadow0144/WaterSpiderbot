<mujoco model="living_room">
  <compiler angle="radian" meshdir="assets/" texturedir="textures/"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.8" rgb2="0.1 0.2 0.3" width="512" height="512"/>
    <material name="floor_mat" specular="0.1" shininess="0.05" rgba="0.6 0.6 0.6 1"/>
    <material name="wall_mat" rgba="0.9 0.9 0.9 1"/>
    <material name="sofa_mat" rgba="0.2 0.3 0.4 1"/>
    <material name="table_mat" rgba="0.4 0.2 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light pos="0.0 0.0 3.0" dir="0.0 0.0 -1.0" diffuse="1 1 1"/>

    <!-- Floor -->
    <geom name="floor" type="plane" size="50.0 50.0 0.1" material="floor_mat"/>

    <!-- Walls -->
    <geom name="wall_front" type="box" pos="49.5 0.0 5.0" size="0.1 50.5 5.0" material="wall_mat"/>
    <geom name="wall_back" type="box" pos="-49.5 0.0 5.0" size="0.1 50.5 5.0" material="wall_mat"/>
    <geom name="wall_left" type="box" pos="0.0 -49.5 5.0" size="50.5 0.1 5.0" material="wall_mat"/>
    <geom name="wall_right" type="box" pos="0.0 49.5 5.0" size="50.5 0.1 5.0" material="wall_mat"/>

    <!-- Sofa -->
    <body name="sofa" pos="0.0 40.0 4.0">
      <geom type="box" size="12.0 4.0 4.0" material="sofa_mat"/>
      <geom type="box" pos="0.0 3.0 4.0" size="12.0 1.0 4.0" material="sofa_mat"/>
    </body>

    <!-- Coffee Table -->
    <body name="coffee_table" pos="0.0 20.0 2.5">
      <geom type="box" size="6.0 4.0 0.5" material="table_mat"/>
      <geom type="box" pos="5.0 3.0 -1.2" size="0.5 0.5 1.2" material="table_mat"/>
      <geom type="box" pos="-5.0 3.0 -1.2" size="0.5 0.5 1.2" material="table_mat"/>
      <geom type="box" pos="5.0 -3.0 -1.2" size="0.5 0.5 1.2" material="table_mat"/>
      <geom type="box" pos="-5.0 -3.0 -1.2" size="0.5 0.5 1.2" material="table_mat"/>
    </body>
  </worldbody>
</mujoco>